# LLM Provider: gigachat | local_openai | auto
LLM_PROVIDER=gigachat

# GigaChat API
GIGACHAT_CREDENTIALS=your-authorization-key-here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_VERIFY_SSL=false

# Local OpenAI-compatible (LM Studio, Ollama, etc.)
LOCAL_BASE_URL=http://127.0.0.1:5000/v1
LOCAL_API_KEY=not-needed
LOCAL_MODEL=local-model
LOCAL_TEMPERATURE=0.3
LOCAL_MAX_TOKENS=4096

# BGE (local GPU)
BGE_MODEL=bge-m3
BGE_DEVICE=cuda

# RAG
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# Tools
TOOLS_LIBRARY_PATH=./tools_library

# Server
HOST=127.0.0.1
PORT=8000
